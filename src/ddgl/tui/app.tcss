Header {
    background: $primary;
}

#main {
    height: 1fr;
}

#pipeline-info {
    width: 30%;
    border: round $panel-lighten-1;
    padding: 1 2;
    content-align: left top;
}

#job-panel {
    width: 70%;
    border: round $panel-lighten-1;
}

LoadingIndicator {
    height: 3;
    width: 100%;
}

DataTable {
    height: 1fr;
}

#filter-bar {
    height: auto;
    background: $panel-darken-1;
}

#search {
    width: 1fr;
}

#status-filter, #stage-filter {
    width: auto;
    min-width: 14;
}

FilterButton.-active {
    border: tall $accent;
}

#sort-button {
    width: auto;
    min-width: 18;
}
